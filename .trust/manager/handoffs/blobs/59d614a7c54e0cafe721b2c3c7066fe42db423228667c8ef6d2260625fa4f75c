<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 940 480" role="img" aria-labelledby="title desc">
  <title id="title">ATL route from request to evidence</title>
  <desc id="desc">A five-stage route with a contract ledger and final trust verdict.</desc>
  <defs><style>
    text{font-family:system-ui,sans-serif;fill:#172033}.title{font-size:20px;font-weight:650}.label{font-size:14px;font-weight:600}.small{font-size:12px;fill:#5b6475}.node{stroke:#64748b;stroke-width:1}.input{fill:#bfdbfe}.process{fill:#c7d2fe}.storage{fill:#99f6e4}.external{fill:#fde68a}.risk{fill:#fecaca}.edge{stroke:#64748b;stroke-width:1.5;fill:none}.zone{fill:none;stroke:#64748b;stroke-width:1;stroke-dasharray:6 5;opacity:.8}
  </style><marker id="arrow" markerWidth="8" markerHeight="8" refX="7" refY="4" orient="auto"><path d="M0 0 8 4 0 8z" fill="#64748b"/></marker></defs>
  <text x="24" y="34" class="title">ATL · contract-to-runtime evidence route</text><text x="24" y="57" class="small">A diagram explains structure; matching observations prove behavior.</text>
  <rect x="20" y="82" width="900" height="175" rx="12" class="zone"/><text x="36" y="106" class="small">WORKFLOW ROUTE</text>
  <path d="M174 170h32m148 0h32m148 0h32m148 0h32" class="edge" marker-end="url(#arrow)"/>
  <g transform="translate(42 132)"><rect width="132" height="76" rx="9" class="input node"/><text x="16" y="28" class="label">1 · Frame</text><text x="16" y="51" class="small">bound the ask</text></g>
  <g transform="translate(206 132)"><rect width="132" height="76" rx="9" class="process node"/><text x="16" y="28" class="label">2 · Specify</text><text x="16" y="51" class="small">name behavior</text></g>
  <g transform="translate(370 132)"><rect width="132" height="76" rx="9" class="process node"/><text x="16" y="28" class="label">3 · Plan</text><text x="16" y="51" class="small">map impact</text></g>
  <g transform="translate(534 132)"><rect width="132" height="76" rx="9" class="storage node"/><text x="16" y="28" class="label">4 · Implement</text><text x="16" y="51" class="small">bounded change</text></g>
  <g transform="translate(698 132)"><rect width="132" height="76" rx="9" class="external node"/><text x="16" y="28" class="label">5 · Verify</text><text x="16" y="51" class="small">show the proof</text></g>
  <rect x="20" y="286" width="560" height="150" rx="12" class="zone"/><text x="36" y="310" class="small">CONTRACT LEDGER · DIRECT OBSERVATIONS</text>
  <path d="M82 340h420" class="edge" marker-end="url(#arrow)"/><circle cx="82" cy="340" r="9" class="storage"/><circle cx="222" cy="340" r="9" class="storage"/><circle cx="362" cy="340" r="9" class="risk"/><circle cx="502" cy="340" r="9" class="risk"/>
  <text x="55" y="375" class="small">bundle</text><text x="188" y="375" class="small">artifact</text><text x="330" y="375" class="small">consumer?</text><text x="470" y="375" class="small">runtime?</text><text x="36" y="413" class="small">green = observed · amber = inferred / unknown</text>
  <g transform="translate(620 286)"><rect width="300" height="150" rx="12" class="risk node"/><text x="20" y="31" class="label">Trust verdict</text><text x="20" y="65" class="label">Conditionally valid</text><text x="20" y="94" class="small">When the consumer or callback</text><text x="20" y="113" class="small">cannot be directly observed.</text></g>
</svg>
