import { readFile } from "node:fs/promises";
import assert from "node:assert/strict";

const client = await readFile("runtime/control-plane-client.js", "utf8");
const scss = await readFile("runtime/scss/_app.scss", "utf8");
assert.match(client, /dir = "auto"/);
assert.match(client, /bidi-auto/);
assert.match(client, /language-toggle/);
assert.ok(client.includes("const fragments = /[A-Za-z0-9][A-Za-z0-9._:/"), "mixed-direction Latin fragments are isolated");
assert.ok(client.includes("escapeHtml(text.slice(offset, match.index)) + ltr(match[0])"), "dynamic log text remains escaped around isolated fragments");
assert.match(client, /event-detail/);
assert.match(client, /bidi\(entry\.detail \|\| entry\.note/);
assert.doesNotMatch(client, /escapeHtml\(event\[3\]\)/, "activity log text must pass through bidi fragment isolation");
assert.match(scss, /Noto Sans Arabic/);
assert.match(scss, /unicode-bidi:plaintext/);
assert.match(scss, /unicode-bidi:isolate/);
console.log("bidi contract: PASS");
