return { errors, derived, rows };
}

if (process.argv[1] && new URL(`file://${process.argv[1].replaceAll("\\", "/")}`).href === import.meta.url) {
const { errors, derived, rows } = auditCatalog();
if (process.argv.includes("--dump")) { console.log(JSON.stringify(derived)); process.exit(0); }
assert.deepEqual(errors, [], errors.join("\n"));
for (const key of Object.keys(en)) { assert.ok(fa[key]?.trim(), `${key}: Persian value`); assert.equal(t(key, "fa"), fa[key]); assert.equal(t(key, "unknown"), en[key]); }
const first = Object.keys(en)[0], saved = fa[first]; delete fa[first]; assert.equal(t(first, "fa"), en[first]); fa[first] = saved; assert.equal(t("__missing__", "fa"), "__missing__");
console.log(`PASS: ${derived.length} source occurrences mapped exactly; ${rows.length} catalog entries and fallback checks passed.`);
}
