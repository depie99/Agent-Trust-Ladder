// Multi-page documentation surfaces: page heroes, catalogs, articles,
// chooser, model routing, codex preview, terminal figures, mobile overflow.

/* Multi-page documentation surfaces */
.brand-link{color:inherit;text-decoration:none}.page-hero{max-width:760px;padding:42px 0 55px}.page-hero h1{font-size:clamp(52px,7vw,86px);margin:16px 0 23px}.page-meta{display:flex;gap:30px;margin-top:28px;padding-top:20px;border-top:1px solid var(--line);font:10px 'DM Mono',monospace;color:var(--faint)}.page-meta strong{display:block;color:var(--ink);font-size:20px;margin-bottom:3px}.catalog-toolbar{display:flex;align-items:end;justify-content:space-between;border-top:1px solid var(--line);padding:28px 0 20px}.catalog-toolbar h2{font-size:23px}.catalog-search{display:flex;gap:8px;align-items:center;width:250px;padding:9px 11px;border:1px solid var(--line);border-radius:8px;color:var(--faint)}.catalog-search input{width:100%;border:0;outline:0;background:transparent;color:var(--ink);font:11px 'DM Mono',monospace}.catalog-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.catalog-card{display:flex;flex-direction:column;min-height:250px;padding:22px;background:var(--panel);border:1px solid var(--line);border-radius:var(--radius);transition:.2s}.catalog-card:hover{border-color:var(--line-strong);transform:translateY(-2px)}.catalog-card[hidden]{display:none}.catalog-card.featured{background:linear-gradient(145deg,var(--grad-soft),var(--panel))}.catalog-top{display:flex;justify-content:space-between;align-items:center}.catalog-card h3{font-size:18px;margin:20px 0 8px}.catalog-card p{font-size:11px;line-height:1.7;color:var(--muted)}.catalog-footer{display:flex;justify-content:space-between;gap:10px;align-items:end;margin-top:auto;padding-top:18px;border-top:1px solid var(--line);font-size:10px;color:var(--faint)}.catalog-footer b{font:9px 'DM Mono',monospace;color:var(--violet);white-space:nowrap}.empty-state{padding:24px;background:var(--panel);border:1px dashed var(--line);border-radius:var(--radius);color:var(--muted);font-size:12px}.empty-state[hidden]{display:none}.callout-panel{display:flex;align-items:center;justify-content:space-between;gap:25px;margin-top:60px;padding:27px 30px;border:1px solid var(--edge-callout);border-radius:var(--radius);background:linear-gradient(100deg,var(--grad-tilt),var(--panel))}.callout-panel h2{font-size:24px;margin:8px 0}.callout-panel p{font-size:11px;color:var(--muted);margin:0;max-width:550px}.guide-article{display:grid;grid-template-columns:185px 1fr;gap:35px;border-top:1px solid var(--line);padding:34px 0}.article-label{font:10px 'DM Mono',monospace;color:var(--violet);letter-spacing:.1em}.mint-label{color:var(--mint)}.amber-label{color:var(--amber)}.coral-label{color:var(--coral)}.article-body h2{font-size:27px;margin:0 0 12px}.article-body>p{max-width:700px;color:var(--muted);font-size:13px;line-height:1.8}.guide-columns{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:24px}.guide-columns h3,.steps-row strong{font-size:12px}.guide-columns pre{margin:10px 0 0;padding:16px;background:var(--inset);border:1px solid var(--line);border-radius:9px;white-space:pre-wrap}.guide-columns code{color:var(--code-ink);font:10px/1.7 'DM Mono',monospace}.guide-columns ul{margin:10px 0;padding-left:18px;color:var(--muted);font-size:12px;line-height:1.9}.article-body pre{margin:12px 0;padding:16px;background:var(--inset);border:1px solid var(--line);border-radius:9px;white-space:pre-wrap;overflow-x:auto;font:10px/1.7 'DM Mono',monospace;color:var(--code-ink)}.steps-row{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-top:25px}.steps-row div{display:grid;gap:7px;padding:15px;border:1px solid var(--line);border-radius:10px;background:var(--panel)}.steps-row b{color:var(--violet);font:10px 'DM Mono',monospace}.steps-row span{font-size:10px;color:var(--faint)}.warning-box{display:flex;gap:14px;margin-top:20px;padding:14px;border-left:2px solid var(--amber);background:var(--callout-amber);font-size:11px}.warning-box strong{color:var(--amber);white-space:nowrap}.warning-box span{color:var(--muted)}.doc-lifecycle{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-top:25px}.doc-lifecycle div{padding:16px;border:1px solid var(--line);border-radius:10px}.doc-lifecycle span{color:var(--amber);font:10px 'DM Mono',monospace}.doc-lifecycle p{font-size:11px;color:var(--muted);line-height:1.6;margin:9px 0 0}.review-matrix{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-top:25px}.review-matrix div{padding:15px;border:1px solid var(--line);border-radius:10px;background:var(--panel)}.review-matrix b,.review-matrix span{display:block}.review-matrix b{font-size:12px}.review-matrix span{font-size:10px;color:var(--muted);line-height:1.6;margin-top:6px}.reference-block{padding:36px 0 0}.question-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.question-grid div,.budget-grid article,.diagram-use-grid article{padding:20px;background:var(--panel);border:1px solid var(--line);border-radius:var(--radius)}.question-grid b{color:var(--violet);font:10px 'DM Mono',monospace}.question-grid h3{font-size:15px;margin:13px 0 6px}.question-grid p,.budget-grid p,.diagram-use-grid p{font-size:11px;line-height:1.65;color:var(--muted);margin:0}.evidence-table{border:1px solid var(--line);border-radius:var(--radius);overflow:hidden}.table-row{display:grid;grid-template-columns:1fr 1.5fr 1.5fr;gap:15px;padding:15px 18px;border-top:1px solid var(--line);font-size:11px;color:var(--muted)}.table-row:first-child{border-top:0}.table-head{font:9px 'DM Mono',monospace;color:var(--faint);text-transform:uppercase;background:var(--panel2)}.table-row b{font:10px 'DM Mono',monospace}.budget-grid,.diagram-use-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.budget-grid article{position:relative;padding-left:45px}.budget-grid h3{font-size:15px;margin:0 0 8px}.budget-dot{position:absolute;top:22px;left:20px;width:12px;height:12px;border-radius:50%}.minimal-dot{background:var(--violet);box-shadow:0 0 12px var(--violet)}.focused-dot{background:var(--mint);box-shadow:0 0 12px var(--mint)}.expanded-dot{background:var(--amber);box-shadow:0 0 12px var(--amber)}.origin-story{display:grid;grid-template-columns:70px 1fr;gap:22px;margin-top:60px;padding:30px;border:1px solid var(--edge-callout);border-radius:var(--radius);background:linear-gradient(145deg,var(--grad-soft),var(--panel))}.origin-mark{display:grid;place-items:center;width:48px;height:48px;border-radius:14px;background:var(--tint-violet);color:var(--violet);font-size:24px}.origin-story h2{font-size:26px;margin:10px 0 12px}.origin-story p{max-width:760px;color:var(--muted);font-size:12px;line-height:1.8}.compact-origin{margin-top:35px}.diagram-feature{display:grid;grid-template-columns:1.25fr .75fr;gap:24px;align-items:center;padding:24px;border:1px solid var(--line);border-radius:var(--radius);background:var(--panel)}.diagram-preview{padding:10px;background:var(--inset);border-radius:10px}.diagram-preview img{display:block;width:100%;height:auto}.diagram-copy h2{font-size:25px;margin:10px 0}.diagram-copy p{font-size:12px;line-height:1.7;color:var(--muted)}.diagram-links{display:flex;gap:8px;flex-wrap:wrap;margin-top:20px}.diagram-use-grid{grid-template-columns:repeat(4,1fr)}.diagram-use-grid b{font-size:13px}.diagram-use-grid p{margin-top:8px}.site-page .content-wrap{padding-top:35px}
@media(max-width:1000px){.catalog-grid{grid-template-columns:repeat(2,1fr)}.question-grid{grid-template-columns:repeat(2,1fr)}.diagram-feature{grid-template-columns:1fr}.diagram-use-grid{grid-template-columns:repeat(2,1fr)}.doc-lifecycle,.review-matrix{grid-template-columns:repeat(2,1fr)}}
@media(max-width:700px){.page-meta{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}.catalog-toolbar{display:block}.catalog-search{width:100%;margin-top:18px}.catalog-grid,.question-grid,.budget-grid,.guide-columns,.steps-row,.doc-lifecycle,.review-matrix,.diagram-use-grid,.diagram-gallery{grid-template-columns:1fr}.guide-article{grid-template-columns:1fr;gap:13px}.callout-panel{display:block}.callout-panel .button{margin-top:18px}.table-row{grid-template-columns:1fr;gap:5px}.table-head{display:none}.origin-story{grid-template-columns:1fr}.origin-mark{margin-bottom:2px}}
.diagram-gallery{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.diagram-gallery article{padding:14px;background:var(--panel);border:1px solid var(--line);border-radius:var(--radius)}.diagram-gallery img{display:block;width:100%;height:150px;object-fit:cover;object-position:top;background:var(--inset);border-radius:9px;margin-bottom:16px}.diagram-gallery b{display:block;font-size:13px}.diagram-gallery p{font-size:11px;color:var(--muted);line-height:1.6;margin:6px 0}.diagram-gallery .text-link{margin-top:3px}
.chooser-panel{margin-top:55px;padding:27px 30px;border:1px solid var(--edge-callout);border-radius:var(--radius);background:linear-gradient(100deg,var(--grad-tilt),var(--panel))}.chooser-panel h2{font-size:25px;margin:9px 0}.chooser-panel>div:first-child p{font-size:12px;color:var(--muted);margin:0}.chooser-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:22px}.chooser-grid label{display:grid;gap:8px;color:var(--faint);font:10px 'DM Mono',monospace}.chooser-grid select{width:100%;padding:12px;border:1px solid var(--line);border-radius:8px;background:var(--panel);color:var(--ink);font:12px system-ui,sans-serif}.chooser-result{display:grid;gap:5px;margin-top:18px;padding:17px;border:1px solid var(--edge-violet);border-radius:10px;background:var(--result-bg)}.chooser-result b{font:9px 'DM Mono',monospace;color:var(--mint);text-transform:uppercase}.chooser-result strong{font-size:16px}.chooser-result span{font-size:11px;color:var(--muted)}
.callout-actions{display:flex;align-items:center;gap:16px;flex-wrap:wrap}

/* Model routing showcase */
.model-route-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin:25px 0 14px}.model-route-card{display:grid;gap:7px;min-height:154px;padding:17px;border:1px solid var(--line);border-radius:12px;background:var(--panel);position:relative;overflow:hidden}.model-route-card::after{content:"";position:absolute;width:85px;height:85px;border-radius:50%;right:-34px;bottom:-40px;opacity:.18}.model-route-card b{font:9px 'DM Mono',monospace;letter-spacing:.12em}.model-route-card strong{font-size:15px}.model-route-card>span:last-child{font-size:10px;line-height:1.6;color:var(--muted)}.model-icon{font-size:21px;line-height:1}.model-code{border-color:var(--edge-violet)}.model-code b,.model-code .model-icon{color:var(--violet)}.model-code::after{background:var(--violet)}.model-judgment{border-color:var(--edge-coral)}.model-judgment b,.model-judgment .model-icon{color:var(--coral)}.model-judgment::after{background:var(--coral)}.model-analysis{border-color:var(--edge-mint)}.model-analysis b,.model-analysis .model-icon{color:var(--mint)}.model-analysis::after{background:var(--mint)}.model-ideas{border-color:var(--edge-amber)}.model-ideas b,.model-ideas .model-icon{color:var(--amber)}.model-ideas::after{background:var(--amber)}.model-loop{display:flex;align-items:center;justify-content:center;gap:10px;flex-wrap:wrap;padding:13px 15px;border:1px solid var(--edge-callout);border-radius:10px;background:linear-gradient(100deg,var(--grad-tilt),var(--panel));color:var(--violet);font:10px 'DM Mono',monospace;letter-spacing:.08em}.model-loop i{color:var(--faint);font-style:normal}.model-loop .loop-review{color:var(--mint)}
@media(max-width:1000px){.model-route-grid{grid-template-columns:repeat(2,1fr)}}
@media(max-width:700px){.model-route-grid{grid-template-columns:1fr}.model-loop{justify-content:flex-start;gap:7px;font-size:9px}}

/* Docs reading system: code cards, on-this-page rail, callouts, pager */
.doc-layout{display:grid;grid-template-columns:minmax(0,1fr) 218px;gap:38px;align-items:start}
.doc-layout>.doc-body{min-width:0}
.doc-toc{position:sticky;top:96px;display:grid;gap:2px;padding-top:6px}
.doc-toc b{font:10px 'DM Mono',monospace;letter-spacing:.13em;color:var(--faint);text-transform:uppercase;margin:0 0 10px 12px}
.doc-toc a{padding:6px 12px;border-left:2px solid var(--line);color:var(--muted);font-size:12px;border-radius:0 7px 7px 0;transition:.15s}
.doc-toc a:hover{color:var(--ink)}
.doc-toc a.active{color:var(--ink);border-left-color:var(--violet);background:var(--hover)}
@media(max-width:1240px){.doc-layout{grid-template-columns:1fr}.doc-toc{display:none}}
section[id],div[id]{scroll-margin-top:96px}
.code-card{margin:14px 0;border:1px solid var(--line);border-radius:10px;background:var(--inset)}
.code-card>b{display:flex;justify-content:space-between;align-items:center;padding:7px 8px 7px 13px;background:var(--panel2);border-bottom:1px solid var(--line);border-radius:9px 9px 0 0;font:9px 'DM Mono',monospace;font-weight:400;letter-spacing:.12em;text-transform:uppercase;color:var(--faint)}
.code-card pre{margin:0;padding:14px 16px;background:transparent;border:0;border-radius:0 0 9px 9px;white-space:pre-wrap;overflow-x:auto;font:11px/1.75 'DM Mono',monospace;color:var(--code-ink)}
.copy-code{background:var(--btn-ghost);border:0;border-radius:5px;padding:4px 9px;font:9px 'DM Mono',monospace;cursor:pointer;color:var(--muted)}
.copy-code:hover{color:var(--ink)}
.doc-callout{display:flex;gap:13px;align-items:flex-start;margin:18px 0;padding:14px 16px;border-left:3px solid;border-radius:0 10px 10px 0;font-size:12px;line-height:1.7;color:var(--muted)}
.doc-callout b{font:10px 'DM Mono',monospace;letter-spacing:.1em;text-transform:uppercase;white-space:nowrap;padding-top:2px}
.doc-callout.tip{border-color:var(--mint);background:var(--callout-mint)}.doc-callout.tip b{color:var(--mint)}
.doc-callout.note{border-color:var(--violet);background:var(--callout-violet)}.doc-callout.note b{color:var(--violet)}
.doc-callout.warn{border-color:var(--amber);background:var(--warn-amber)}.doc-callout.warn b{color:var(--amber)}
.doc-pager{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:64px}
.doc-pager a{display:grid;gap:6px;padding:18px 20px;background:var(--panel);border:1px solid var(--line);border-radius:var(--radius);transition:.2s}
.doc-pager a:hover{border-color:var(--line-strong);transform:translateY(-2px)}
.doc-pager span{font:9px 'DM Mono',monospace;letter-spacing:.13em;color:var(--faint);text-transform:uppercase}
.doc-pager strong{font-size:14px;color:var(--ink)}
.doc-pager a.next{text-align:right}
@media(max-width:700px){.doc-pager{grid-template-columns:1fr}}

/* Codex history bridge: explain the real provider surface without disguising a mock as live chat. */
.bridge-diagram{margin-top:36px}.bridge-diagram .diagram-preview{border:1px solid var(--line);overflow:hidden}.bridge-diagram .diagram-preview img{aspect-ratio:1200/520;object-fit:cover}
.codex-ui-preview{margin-top:24px;border:1px solid var(--preview-edge);border-radius:14px;overflow:hidden;background:var(--inset);box-shadow:0 16px 45px var(--preview-shadow)}.codex-ui-head,.codex-ui-foot{display:flex;align-items:center;justify-content:space-between;gap:16px;padding:13px 17px;background:var(--panel2);color:var(--muted);font:10px 'DM Mono',monospace}.codex-ui-head span{display:flex;align-items:center;gap:8px;color:var(--ink);font-size:12px}.codex-ui-head i{width:8px;height:8px;border-radius:50%;background:var(--mint);box-shadow:0 0 10px var(--mint)}.codex-ui-head b{color:var(--mint);font-weight:400}.codex-ui-body{display:grid;gap:12px;padding:20px}.codex-message{padding:16px;border-radius:10px;border:1px solid var(--line)}.codex-message small{display:block;color:var(--faint);font:9px 'DM Mono',monospace;letter-spacing:.1em;margin-bottom:9px}.codex-message strong{display:block;color:var(--msg-ink);font:11px/1.7 'DM Mono',monospace}.codex-message p{margin:8px 0 0;color:var(--muted);font-size:11px;line-height:1.6}.codex-message em{display:block;margin-top:10px;color:var(--mint);font:10px 'DM Mono',monospace;font-style:normal}.codex-message-context{border-color:var(--edge-violet);background:var(--msg-context)}.codex-message-system{border-color:var(--edge-mint);background:var(--msg-mint)}.codex-message-system p{display:flex;align-items:center;gap:9px}.status-pill{display:inline-block;padding:3px 6px;border-radius:4px;color:var(--on-mint);background:var(--mint);font:9px 'DM Mono',monospace;font-weight:700}.codex-ui-foot{border-top:1px solid var(--line);font-size:9px;color:var(--faint)}
@media(max-width:700px){.codex-ui-head,.codex-ui-foot{align-items:flex-start;flex-direction:column;gap:7px}.codex-ui-body{padding:12px}.codex-message-system p{align-items:flex-start;flex-direction:column}}

@media(max-width:700px){
  html,body{overflow-x:hidden}
  .app-shell,main{width:100vw;max-width:100vw;min-width:0;overflow-x:hidden}
  main,.content-wrap,.page-hero,.article-body,.diagram-feature{min-width:0;max-width:100%}
  .content-wrap{width:calc(100vw - 36px)!important;max-width:calc(100vw - 36px)!important;margin-left:18px;margin-right:18px;padding-left:0;padding-right:0;overflow-wrap:anywhere}
  .page-hero h1{font-size:clamp(42px,14vw,58px);overflow-wrap:anywhere}
  .hero-copy,.article-body>p,.guide-columns p,.diagram-copy p{overflow-wrap:anywhere}
  .diagram-feature .diagram-preview img{max-width:100%;height:auto}
}

/* Terminal interface figures (generated by scripts/render-tui-images.mjs) */
.terminal-figure{margin:20px 0 6px;padding:10px;background:var(--inset);border:1px solid var(--terminal-edge);border-radius:12px}
.terminal-figure img{display:block;width:100%;height:auto;border-radius:8px}
.terminal-figure figcaption{margin-top:10px;padding:0 6px;color:var(--muted);font-size:11.5px;line-height:1.7}
.terminal-grid{display:grid;grid-template-columns:1fr 1fr;gap:18px;margin-top:20px}
.terminal-grid .terminal-figure{margin:0}
@media (max-width:1080px){.terminal-grid{grid-template-columns:1fr}}

/* Theme-aware diagram figures: dark source plus a generated light variant
   (scripts/make-diagram-light-variants.mjs). Both imgs ship; CSS picks one
   per theme, so the swap is flash-free and works without JS. */
.themesvg{display:block}
.themesvg img{width:100%;height:auto;display:block}
.themesvg .fig-light{display:none}
html.light .themesvg .fig-light{display:block}
html.light .themesvg .fig-dark{display:none}
