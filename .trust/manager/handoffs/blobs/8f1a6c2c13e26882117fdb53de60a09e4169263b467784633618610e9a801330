// Shared docs content system: guide/example cards, prompt samples,
// reference tables, search results.

/* Docs content system */
.section-note{font-size:11px;color:var(--faint)}
.guide-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:12px}
.guide-card{display:flex;gap:15px;align-items:flex-start;position:relative;min-height:150px;padding:22px;background:var(--panel);border:1px solid var(--line);border-radius:var(--radius);transition:.2s}
.guide-card:hover,.example-card:hover{border-color:var(--line-strong);transform:translateY(-2px)}
.guide-number{display:grid;place-items:center;flex:0 0 34px;height:34px;border-radius:9px;color:var(--violet);background:var(--tint-violet);font:10px 'DM Mono',monospace}
.mint-number{color:var(--mint);background:var(--tint-mint)}.amber-number{color:var(--amber);background:var(--tint-amber)}.coral-number{color:var(--coral);background:var(--tint-coral)}
.guide-card h3{font-size:14px;margin:1px 0 8px;letter-spacing:-.02em}.guide-card p{color:var(--muted);font-size:11px;line-height:1.65;margin-bottom:12px;max-width:340px}.guide-card strong{font:10px 'DM Mono',monospace;color:var(--faint)}
.example-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.example-card{display:flex;flex-direction:column;min-height:325px;padding:22px;background:var(--panel);border:1px solid var(--line);border-radius:var(--radius);transition:.2s}.example-meta{display:flex;align-items:center;justify-content:space-between;gap:8px;font:9px 'DM Mono',monospace;color:var(--faint)}.example-card h3{font-size:17px;margin:18px 0 8px}.example-context{font-size:11px;line-height:1.65;color:var(--muted);min-height:54px}.prompt-sample{display:flex;gap:8px;align-items:flex-start;position:relative;margin-top:15px;padding:12px;background:var(--inset);border:1px solid var(--line);border-radius:9px}.prompt-sample>span{color:var(--violet);font-size:18px;line-height:1}.prompt-sample code{padding-right:38px;color:var(--code-ink);font:10px/1.7 'DM Mono',monospace;white-space:normal}.copy-example{position:absolute;right:8px;top:8px;background:var(--btn-ghost);border:0;border-radius:5px;padding:4px 6px;cursor:pointer;color:var(--muted);font:9px 'DM Mono',monospace}.example-proof{display:flex;gap:7px;align-items:flex-start;margin-top:auto;padding-top:16px;font-size:10px;line-height:1.55}.example-proof b{color:var(--ink);white-space:nowrap}.example-proof span{color:var(--faint)}
.reference-section{padding-top:78px}.reference-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:12px}.reference-grid article{min-height:145px;padding:20px;background:var(--panel);border:1px solid var(--line);border-radius:var(--radius)}.ref-key{font:9px 'DM Mono',monospace;color:var(--violet);letter-spacing:.12em}.reference-grid h3{font-size:14px;margin:14px 0 7px}.reference-grid p{color:var(--muted);font-size:11px;line-height:1.65}
.search-results{display:grid;gap:6px;margin-top:15px;max-height:270px;overflow:auto}.search-results a{display:flex;justify-content:space-between;gap:12px;padding:10px;border-radius:7px;background:var(--panel2);font-size:11px}.search-results a:hover{background:var(--btn-ghost)}.search-results a span{color:var(--faint);font:9px 'DM Mono',monospace}.no-results{font-size:11px;color:var(--faint)}
@media(max-width:1000px){.example-grid{grid-template-columns:1fr 1fr}.reference-grid{grid-template-columns:1fr 1fr}}
@media(max-width:700px){.guide-grid,.example-grid,.reference-grid{grid-template-columns:1fr}.section-note{display:none}.guide-card{min-height:0}.example-card{min-height:0}.example-context{min-height:0}}
